# ReLoop configuration. Copy to .env and fill in what you need.
# With DEMO_MODE=true the app runs with NO keys at all (scripted AI + simulated PayPal).

DATABASE_URL="file:./dev.db"

# true  = deterministic AI fixtures (3 scripted scenarios), no Anthropic key needed
# false = real Claude calls (requires ANTHROPIC_API_KEY)
DEMO_MODE=true
ANTHROPIC_API_KEY=

# Demo-only controls ("Demo control" buttons that stand in for the recycler). No real recycler exists.
# Leave true for the hosted demo; set false to hide them.
DEMO_ACTIONS=true

# PayPal SANDBOX credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Optional and ignored by the app: the browser SDK always uses PAYPAL_CLIENT_ID so both sides are the same PayPal app.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# DEV ONLY (ignored when NODE_ENV=production): shows a labelled "Simulate buyer approval" button that marks a job
# paid with a fake authorization. Real sandbox authorization is still a ship requirement.
PAYPAL_SIMULATE_APPROVAL=false
# DEV ONLY: send sandbox payouts to this sandbox Personal account email instead of the seeded technician emails
# (seeded emails are not real sandbox accounts, so real payouts to them show as UNCLAIMED).
PAYPAL_PAYOUT_RECEIVER_OVERRIDE=

# Public base URL (used for PayPal return URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Platform fee taken from each repair payout, in basis points (1000 = 10%)
PLATFORM_FEE_BPS=1000

# Claude model for live mode. Defaults to the one in lib/ai/config.ts; set a cheaper model to cut cost.
# ANTHROPIC_MODEL=

# Max live Claude calls per UTC day; beyond it the app falls back to scripted demo mode (with a notice).
AI_DAILY_CALL_CAP=200

# Judge help panel ("Demo guide"). The buyer password is NOT shown in the UI; it lives in the README.
NEXT_PUBLIC_DEMO_BUYER_EMAIL=
NEXT_PUBLIC_DEMO_BUYER_NOTE=

# Optional: store uploads somewhere other than public/uploads.
# UPLOAD_DIR=

# Local only: set true to wipe and reseed the database on `prisma db seed` (same as `npm run db:reset`).
# SEED_RESET=false
