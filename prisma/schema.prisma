// SQLite has no native enums in Prisma, so status/type fields are strings
// validated in TypeScript (see lib/jobs/state-machine.ts and lib/ai/schemas.ts).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Owner {
  id      String   @id @default(cuid())
  name    String
  email   String   @unique
  devices Device[]
}

model Technician {
  id           String           @id @default(cuid())
  name         String
  city         String
  bio          String
  skills       String // comma separated: phone,laptop,tv,...
  rating       Float
  distanceKm   Float
  hourlyCents  Int
  paypalEmail  String // sandbox receiver for Payouts
  isTrainee    Boolean          @default(false)
  jobs         Job[]
  repairs      VerifiedRepair[]
}

model Device {
  id        String   @id @default(cuid())
  ownerId   String
  owner     Owner    @relation(fields: [ownerId], references: [id])
  type      String // phone | laptop | tablet | tv | appliance | other
  brand     String
  model     String
  ageYears  Int
  problem   String
  photoPath String?
  scenario  String? // demo scenario key if created from a scripted case
  diagnosisJson String? // validated + safety-gated Diagnosis
  diagnosisSource String? // fixture | claude
  guideJson String? // generated DIY guide
  createdAt DateTime @default(now())
  jobs      Job[]
}

model Job {
  id                 String       @id @default(cuid())
  deviceId           String
  device             Device       @relation(fields: [deviceId], references: [id])
  technicianId       String?
  technician         Technician?  @relation(fields: [technicianId], references: [id])
  status             String // quoted | paid | accepted | in_progress | completed | customer_confirmed | payout_released
  diagnosisJson      String // validated Diagnosis (zod)
  quoteJson          String? // itemised quote
  partsCents         Int          @default(0)
  laborCents         Int          @default(0)
  logisticsCents     Int          @default(0)
  totalCents         Int          @default(0)
  platformFeeCents   Int          @default(0)
  payoutCents        Int          @default(0)
  paypalOrderId      String?
  paypalAuthId       String?
  paypalCaptureId    String?
  payoutBatchId      String?
  payoutStatus       String?
  payoutMode         String? // paypal_sandbox | simulated (| fallback_ledger on seeded rows)
  payoutItemId       String?
  payoutNote         String? // plain-words explanation shown in the UI (simulated reason, unclaimed, ...)
  payoutError        String? // last payout failure, cleared on success
  payoutAttempt      Int          @default(0) // bumps only after PayPal definitively failed an item; part of sender_batch_id
  authSimulated      Boolean      @default(false) // true = authorization never existed at PayPal (SIMULATED)
  authorizedAt       DateTime?
  reauthCount        Int          @default(0)
  problemReport      String? // set by the owner; blocks capture until the technician re-uploads proof
  proofPhotoPath     String?
  proofNotes         String?
  customerRating     Int?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  events             JobEvent[]
  repair             VerifiedRepair?
}

model JobEvent {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())
}

model VerifiedRepair {
  id           String     @id @default(cuid())
  jobId        String     @unique
  job          Job        @relation(fields: [jobId], references: [id])
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])
  deviceType   String
  repairType   String
  rating       Int
  payoutRef    String?
  completedAt  DateTime
}

model Donation {
  id              String    @id @default(cuid())
  publicId        String    @unique @default(uuid()) // unguessable: gates the confirmation page and certificate
  donorName       String // as typed by the donor; public lists show first name only
  message         String?
  amountCents     Int
  status          String    @default("created") // created | capturing | completed | pending
  simulated       Boolean   @default(false)
  paypalOrderId   String?
  paypalCaptureId String?
  deviceId        String?
  capturedAt      DateTime?
  createdAt       DateTime  @default(now())
}

model RecyclingPickup {
  id          String    @id @default(cuid())
  deviceId    String    @unique
  address     String
  pickupDate  String // YYYY-MM-DD
  recycler    String // always the labelled demo partner
  status      String    @default("booked") // booked | collected | processed
  kgDiverted  Float
  demo        Boolean   @default(true)
  collectedAt DateTime?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

// Outcomes feeding the impact dashboard. deviceId is unique so a device is counted once.
model ImpactEvent {
  id          String   @id @default(cuid())
  deviceId    String?  @unique
  deviceType  String
  outcome     String // repair | refurbish | donate | recycle
  ewasteKg    Float
  co2eKg      Float
  demo        Boolean  @default(false) // seeded or simulated
  createdAt   DateTime @default(now())
}

// Idempotency log for PayPal webhooks: a given event id is processed once.
model WebhookEvent {
  id         String   @id @default(cuid())
  eventId    String   @unique
  type       String
  jobId      String?
  simulated  Boolean  @default(false)
  receivedAt DateTime @default(now())
}
